      "lepesek": [
        {
          "id": "1-01",
          "text": "Ez a jegyzetoldal kezdőlapja.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "teljes"
        },
        {
          "id": "1-02",
          "text": "Bal oldalt, a {menüben} találod a tantárgyakat, és innen bármikor visszajutsz a kezdőlapra.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "teljes",
          "kiemel": [
            {
              "szereplo": "oldalsav",
              "horgony": "menüben",
              "kell": "[[tantargy]]"
            }
          ]
        },
        {
          "id": "1-03",
          "text": "A menüben a {Podcast} lap az összes adást egy helyen gyűjti, {A projektről} szóló lap pedig elmondja, hogyan készül a jegyzet.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "teljes",
          "kiemel": [
            {
              "szereplo": "menu-podcast",
              "horgony": "Podcast",
              "kell": "Podcast"
            },
            {
              "szereplo": "menu-projekt",
              "horgony": "A projektről",
              "kell": "A projektről"
            }
          ]
        },
        {
          "id": "1-04",
          "text": "Középen a {Tantárgyak} lista áll; a tantárgyak neve alatt a fejezeteik is ott vannak.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "tartalom",
          "kiemel": [
            {
              "szereplo": "tantargyak-cim",
              "horgony": "Tantárgyak",
              "kell": "Tantárgyak"
            }
          ],
          "gorget": {
            "szereplo": "tantargyak-cim",
            "igazit": "felso"
          }
        },
        {
          "id": "1-05",
          "text": "Alatta a {Hogyan használd} rész leírja, milyen lapokat találsz az oldalon.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "elem",
          "kiemel": [
            {
              "szereplo": "hogyan-hasznald",
              "horgony": "Hogyan használd",
              "szerkezet": "utmutato"
            }
          ],
          "gorget": {
            "szereplo": "hogyan-hasznald",
            "igazit": "felso"
          }
        },
        {
          "id": "1-06",
          "text": "A {Jelmagyarázat} a szöveg alatti kis címkék jelentését sorolja fel.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "elem",
          "kiemel": [
            {
              "szereplo": "jelmagyarazat-cim",
              "horgony": "Jelmagyarázat",
              "kell": "Jelmagyarázat"
            }
          ],
          "gorget": {
            "szereplo": "jelmagyarazat-cim",
            "igazit": "felso"
          }
        },
        {
          "id": "1-07",
          "text": "Ezeket a címkéket egy leckében mindjárt látni fogod.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "elem",
          "kiemel": [
            {
              "szereplo": "jelmagyarazat-elso",
              "kell": "Magyarázat"
            }
          ],
          "gorget": {
            "szereplo": "jelmagyarazat-elso",
            "igazit": "felso"
          }
        },
        {
          "id": "1-08",
          "text": "Fent, a {Keresés} mezővel bármelyik leckét gyorsan megtalálod.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "teljes",
          "kiemel": [
            {
              "szereplo": "kereses",
              "horgony": "Keresés",
              "kell": "Keresés"
            }
          ]
        },
        {
          "id": "1-09",
          "text": "Ha beírod, hogy [[keresoszo]], a találatok között ott a {[[lecke]]} lecke.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "teljes",
          "kiemel": [
            {
              "szereplo": "kereses-talalat",
              "horgony": "[[lecke]]",
              "kell": "[[lecke]]"
            }
