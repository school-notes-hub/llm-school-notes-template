            "kattint": false
          }
        },
        {
          "id": "1-10",
          "text": "Most nyissuk meg [[a_tantargy]] tantárgyat.",
          "szunet": 0.6,
          "lap": "kezdolap",
          "kamera": "teljes",
          "allapot": [
            {
              "szereplo": "kereses",
              "muvelet": "esc"
            }
