{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "hits",
    "owner_notes"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "verdict",
          "answer",
          "severity"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verdict": {
            "enum": [
              "ok",
              "not-ok",
              "accept",
              "keep"
            ]
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "enum": [
              "hiba",
              "javaslat"
            ]
          }
        }
      }
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hit_id",
          "verdict",
          "reason",
          "severity",
          "item_key"
        ],
        "properties": {
          "hit_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verdict": {
            "enum": [
              "hiba",
              "megengedett",
              "téves"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "enum": [
              "hiba",
              "javaslat"
            ]
          },
          "item_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "owner_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "quote",
          "category",
          "problem",
          "suggestion",
          "relates_to",
          "severity",
          "item_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[1-9][0-9]*$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "suggestion": {
            "type": "string"
          },
          "relates_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "new_evidence": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "hiba",
              "javaslat"
            ]
          },
          "item_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
