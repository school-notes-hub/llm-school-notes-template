{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fetch.json (plan 4.4)",
  "type": "object",
  "required": ["student", "run_id", "mode", "packages", "pages", "range", "open_review_items",
               "pending_images"],
  "additionalProperties": false,
  "properties": {
    "pending_figures": {"type": "array", "items": {"type": "object"}},
    "student": {"type": "string"},
    "run_id": {"type": "string"},
    "mode": {"enum": ["cron", "interactive", "repair", "fix"]},
    "packages": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["drive_folder", "subject", "role", "new_subject", "preconverted", "files"],
      "properties": {
        "drive_folder": {"type": "string"},
        "subject": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "card": {"$ref": "urn:school-notes:subject-card"},
        "role": {"enum": ["fuzet", "tanari"]},
        "drive_description": {"type": "string"},
        "new_subject": {"type": "boolean"},
        "preconverted": {"type": "boolean"},
        "files": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["file", "original_sha256", "pages"],
          "properties": {"file": {"type": "string"},
                         "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                         "pages": {"type": "integer", "minimum": 1}}}}}}},
    "pages": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "package", "file", "page", "path", "sha256", "duplicate_of"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "package": {"type": "string"},
        "file": {"type": "string"},
        "page": {"type": ["integer", "null"]},
        "path": {"type": "string", "pattern": "^sources/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duplicate_of": {"type": ["string", "null"]}}}},
    "range": {"type": "object", "additionalProperties": false, "required": ["from", "to", "k", "n"],
              "properties": {"from": {"type": "integer"}, "to": {"type": "integer"},
                             "k": {"type": "integer", "minimum": 1},
                             "n": {"type": "integer", "minimum": 1}}},
    "open_review_items": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["file", "item_id"],
      "properties": {"round": {"enum": [1, 2]}, "chain": {"enum": [0, 1]},
                     "status": {"enum": ["open", "owner"]},
                     "key": {"type": "string", "pattern": "^docs/review/(?!.*\\.\\.)[^\\\\#]+\\.md#R[0-9]+$"},
                     "file": {"type": "string"}, "item_id": {"type": "string", "pattern": "^R[0-9]+$"}}}},
    "pending_images": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["plan_id", "page"],
      "properties": {"plan_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
                     "page": {"type": "string"}}}},
    "conflict_files": {"type": "array", "items": {"type": "string"}},
    "subject": {"type": "string"},
    "card": {"$ref": "urn:school-notes:subject-card"},
    "repair_targets": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["page", "kind", "sources", "related"],
      "properties": {"page": {"type": "string"}, "kind": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "related": {"type": "array", "items": {"type": "string"}}}}},
    "offline": {"type": "boolean"}
  }
}
