{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hits",
    "owner_notes"
  ],
  "properties": {
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hit_id",
          "verdict",
          "covered_by",
          "reason"
        ],
        "properties": {
          "hit_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verdict": {
            "enum": [
              "hiba",
              "megengedett",
              "téves"
            ]
          },
          "covered_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "owner_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
