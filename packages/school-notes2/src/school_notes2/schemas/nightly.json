{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review.json, the reviewer's output (plan 4.7)",
  "type": "object",
  "required": [
    "verdict",
    "pages",
    "findings",
    "items",
    "hits",
    "owner_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "owner_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "verdict": {
      "enum": [
        "ok",
        "changes"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "problem",
          "relates_to",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string"
          },
          "relates_to": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:[a-z0-9-]+|docs/review/(?!.*\\.\\.)[^\\\\#]+\\.md#R[0-9]+)$"
          },
          "new_evidence": {
            "type": "string",
            "pattern": "\\S"
          },
          "category": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "verdict"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verdict": {
            "enum": [
              "ok",
              "changes"
            ]
          },
          "first_glance": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "verdict",
          "answer"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verdict": {
            "enum": [
              "ok",
              "not-ok",
              "accept",
              "keep",
              "open",
              "resolved"
            ]
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hit_id",
          "verdict",
          "covered_by",
          "reason"
        ],
        "properties": {
          "hit_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verdict": {
            "enum": [
              "hiba",
              "megengedett",
              "téves"
            ]
          },
          "covered_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
