{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The reviewer's verdict on one podcast script (`verdict.json` in the podcast hand-over). `key` is copied from the `keys.json` that `sn podcast --snapshot` wrote: the verdict holds for that content only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "verdict", "observed", "defects"],
  "properties": {
    "key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict": {"enum": ["accept", "reject"]},
    "observed": {"type": "string", "minLength": 1},
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "observed", "expected", "severity"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "observed": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "severity": {"enum": ["hiba", "javaslat"]}
        }
      }
    }
  }
}
