{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One-time repair queue (plan 11.2)",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "items", "figures"],
  "properties": {
    "schema": {"const": 1},
    "items": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["page", "kind", "status", "priority", "matches", "urgent", "last_lesson", "depends_on"],
      "properties": {
        "page": {"type": "string", "pattern": "^wiki/(?!.*\\.\\.)[^\\\\]+\\.md$"},
        "kind": {"type": "string"},
        "status": {"enum": ["pending", "done", "owner"]},
        "priority": {"type": ["integer", "null"], "minimum": 0},
        "matches": {"type": "integer", "minimum": 0},
        "urgent": {"type": "boolean"},
        "last_lesson": {"type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})?$"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }},
    "figures": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "pages", "matches", "status"],
      "properties": {
        "file": {"type": "string", "pattern": "^wiki/assets/(?!.*\\.\\.)[^\\\\]+\\.svg$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "matches": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pending", "keep", "context", "remake"]}
      }
    }}
  }
}
