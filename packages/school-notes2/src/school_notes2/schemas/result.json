{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result.json, the writer's output (plan 4.5)",
  "type": "object",
  "required": ["status"],
  "additionalProperties": false,
  "properties": {
    "owner_notes": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "status": {"enum": ["done", "question"]},
    "questions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}}}},
    "notes": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["file", "pages"],
      "properties": {"file": {"type": "string", "pattern": "^wiki/[a-z0-9-]+/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+-jegyzet\\.md$"},
                     "pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}}}},
    "new_subjects": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["subject", "emoji", "color"],
      "properties": {"subject": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                     "emoji": {"type": "string", "minLength": 1, "maxLength": 16},
                     "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}}},
    "review_closure": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["file", "item_id", "status"],
      "properties": {"file": {"type": "string", "pattern": "^docs/review/(?!.*\\.\\.)[^/][^\\\\]*\\.md$"},
                     "item_id": {"type": "string", "pattern": "^R[0-9]+$"},
                     "status": {"enum": ["fixed", "disagree", "open"]},
                     "note": {"type": "string"}}}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["page", "image", "locator", "observed", "decision"],
      "properties": {"page": {"type": "string", "pattern": "^wiki/(?!.*\\.\\.)[^\\\\]+\\.md$"},
                     "image": {"type": ["string", "integer"]},
                     "locator": {"type": "string"},
                     "observed": {"type": "string", "minLength": 1},
                     "decision": {"enum": ["changed", "confirmed", "unresolved"]},
                     "note": {"type": "string"}}}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "question"}}},
             "then": {"required": ["questions"], "properties": {"questions": {"minItems": 1}}}}]
}
