{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result.json, the writer's output (plan 4.5)",
  "type": "object",
  "required": ["status"],
  "additionalProperties": false,
  "properties": {
    "owner_notes": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "status": {"enum": ["done", "question"]},
    "questions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}}}},
    "notes": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["file", "pages"],
      "properties": {"file": {"type": "string", "pattern": "^wiki/[a-z0-9-]+/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+-jegyzet\\.md$"},
                     "pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}}}},
    "new_subjects": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["subject", "emoji", "color"],
      "properties": {"subject": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                     "emoji": {"type": "string", "minLength": 1, "maxLength": 16},
                     "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}}},
    "figures": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "kind", "page"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "page": {"$ref": "#/$defs/page"},
                     "kind": {"enum": ["notebook-drawing", "teacher-drawing", "figure", "banner", "infographic"]}}}},
    "notebook_drawings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["source", "crop", "figure"],
      "properties": {"source": {"$ref": "#/$defs/source"}, "crop": {"$ref": "#/$defs/text"},
                     "figure": {"$ref": "#/$defs/id"}}}},
    "figure_requests": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "page", "source", "crop", "purpose", "origin"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "page": {"$ref": "#/$defs/page"},
                     "source": {"$ref": "#/$defs/source"}, "crop": {"$ref": "#/$defs/text"},
                     "purpose": {"$ref": "#/$defs/text"},
                     "origin": {"enum": ["teacher-own", "third-party", "unknown"]}}}},
    "warnings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "action", "reason"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "action": {"enum": ["rewritten", "kept"]},
                     "reason": {"$ref": "#/$defs/text"}}}},
    "coverage": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["source", "unit"],
      "properties": {"source": {"$ref": "#/$defs/source"}, "unit": {"$ref": "#/$defs/text"},
                     "target": {"type": "string", "pattern": "^wiki/(?!.*\\.\\.)[^\\\\#]+\\.md#[^\\s#]+$"},
                     "reason": {"$ref": "#/$defs/text"}},
      "oneOf": [{"required": ["target"], "not": {"required": ["reason"]}},
                {"required": ["reason"], "not": {"required": ["target"]}}]}},
    "review_closure": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["file", "item_id", "status"],
      "allOf": [{"if": {"properties": {"status": {"const": "disagree"}}},
                 "then": {"required": ["note"], "properties": {"note": {"type": "string", "pattern": "\\S"}}}},
                {"if": {"properties": {"status": {"const": "question"}}}, "then": {"required": ["question_id"], "not": {"required": ["decision_id"]}}},
                {"if": {"properties": {"status": {"const": "settled"}}}, "then": {"oneOf": [{"required": ["question_id"], "not": {"required": ["decision_id"]}}, {"required": ["decision_id"], "not": {"required": ["question_id"]}}]}}],
      "properties": {"file": {"type": "string", "pattern": "^docs/review/(?!.*\\.\\.)[^/][^\\\\]*\\.md$"},
                     "item_id": {"type": "string", "pattern": "^R[0-9]+$"},
                     "status": {"enum": ["fixed", "disagree", "question", "settled", "open"]},
                     "note": {"type": "string"},
                     "question_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                     "decision_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}}}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["page", "image", "locator", "observed", "decision"],
      "properties": {"page": {"type": "string", "pattern": "^wiki/(?!.*\\.\\.)[^\\\\]+\\.md$"},
                     "image": {"type": ["string", "integer"]},
                     "locator": {"type": "string"},
                     "observed": {"type": "string", "minLength": 1},
                     "decision": {"enum": ["changed", "confirmed", "unresolved"]},
                     "note": {"type": "string"}}}}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "page": {"type": "string", "pattern": "^wiki/(?!.*\\.\\.)[^\\\\]+\\.md$"},
    "source": {"type": "string", "pattern": "^sources/(?!.*\\.\\.)[^\\\\]+$"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "question"}}},
             "then": {"required": ["questions"], "properties": {"questions": {"minItems": 1}}}}]
}
