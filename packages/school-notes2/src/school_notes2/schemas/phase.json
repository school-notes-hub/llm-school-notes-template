{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phase.json (plan 4.11)",
  "type": "object",
  "required": ["schema", "kind", "mode", "student", "run_id", "phase", "created", "updated",
               "data", "retries", "llm_failures", "finish_task", "needs_owner", "last_error"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "kind": {"enum": ["notes", "review", "publish"]},
    "mode": {"enum": ["cron", "interactive"]},
    "student": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "phase": {"enum": ["downloading", "downloaded", "moved", "prepared", "writing", "finishing",
                        "committed", "built", "pushing", "pushed", "done",
                        "reviewing", "reviewed", "closing", "figures", "inspecting",
                        "correcting", "rechecking", "review_ready", "waiting_quota"]},
    "created": {"type": "string"},
    "updated": {"type": "string"},
    "closed": {"type": "boolean"},
    "data": {"type": "object"},
    "retries": {"type": "integer", "minimum": 0},
    "llm_failures": {"type": "integer", "minimum": 0},
    "finish_task": {"type": ["string", "null"]},
    "needs_owner": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["reason", "todo", "class", "at"],
         "properties": {"reason": {"type": "string"}, "todo": {"type": "string"},
                        "class": {"type": "string"}, "at": {"type": "string"}}}
      ]
    },
    "last_error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["class", "message", "at"]}
      ]
    }
  }
}
