# school-notes-agent: the harness runtime (plan 7.3). No secrets are ever copied in.
# Build from the release root (the template instance):
#   podman build -f packages/school-notes2/src/school_notes2/container/Containerfile \
#     --build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g) \
#     -t localhost/school-notes-agent:<tag> .
# Base: node:24-trixie-slim, because both harnesses ship as npm packages and the
# Debian trixie userland is the one measured on the VM (2026-10-03).
FROM docker.io/library/node:24-trixie-slim@sha256:8ec5d7557396cfe32d21c3f9c13072355ceab22b584578ca4bb28af31120cffe

ARG CLAUDE_CODE_VERSION=2.1.288
ARG CODEX_VERSION=0.160.0
ARG AGENT_UID=1000
ARG AGENT_GID=1000
ARG WITH_FREECAD=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl dnsutils iptables socat ripgrep util-linux procps \
      librsvg2-bin graphviz python3 python3-venv \
      default-jre-headless povray ffmpeg \
 && if [ "$WITH_FREECAD" = "1" ]; then apt-get install -y --no-install-recommends freecad; fi \
 && rm -rf /var/lib/apt/lists/*

# PlantUML: the official versioned JAR with a verified digest (install-visual-tools.md); the
# Debian package is from 2020 and lacks the options visual_tools.py uses.
ARG PLANTUML_VERSION=1.2026.8
ARG PLANTUML_SHA256=5e1ecfa8ecd32c90b03bbf3b1eb6f020943f98ab0fcf4032be31a0002ee2c462
RUN mkdir -p /usr/share/plantuml \
 && curl --fail --location --silent --show-error --output /tmp/plantuml.jar \
      "https://github.com/plantuml/plantuml/releases/download/v${PLANTUML_VERSION}/plantuml.jar" \
 && echo "${PLANTUML_SHA256}  /tmp/plantuml.jar" | sha256sum --check - \
 && mv /tmp/plantuml.jar /usr/share/plantuml/plantuml.jar && chmod 644 /usr/share/plantuml/plantuml.jar

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "@openai/codex@${CODEX_VERSION}" \
 && npm cache clean --force

# The learner repo's tools/ need the template's Python environment (with the `visuals`
# group). It is installed here, outside the worktree; at runtime uv stays offline.
COPY --from=docker.io/astral/uv:0.10.12@sha256:72ab0aeb448090480ccabb99fb5f52b0dc3c71923bffb5e2e26517a1c27b7fec /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock /opt/visuals/
RUN cd /opt/visuals \
 && UV_PROJECT_ENVIRONMENT=/opt/visuals/.venv UV_PYTHON_DOWNLOADS=never \
    uv sync --frozen --no-install-project --group visuals \
 && chmod -R a+rX /opt/visuals

# The `agent` user has the owner's VM uid, so files written in /work belong to the owner.
RUN if getent passwd "$AGENT_UID" >/dev/null; then userdel -r "$(getent passwd "$AGENT_UID" | cut -d: -f1)"; fi \
 && if getent group "$AGENT_GID" >/dev/null; then groupdel "$(getent group "$AGENT_GID" | cut -d: -f1)"; fi \
 && groupadd -g "$AGENT_GID" agent \
 && useradd -u "$AGENT_UID" -g agent -d /home/agent -M -s /bin/bash agent \
 && mkdir -p /home/agent /work /run/sn && chown agent:agent /home/agent

COPY packages/school-notes2/src/school_notes2/container/entrypoint.sh /usr/local/sbin/sn-entrypoint
COPY packages/school-notes2/src/school_notes2/container/init-firewall.sh /usr/local/sbin/sn-init-firewall
COPY packages/school-notes2/src/school_notes2/container/sn-preflight /usr/local/sbin/sn-preflight
COPY packages/school-notes2/src/school_notes2/container/clean-home.sh /usr/local/sbin/sn-clean-home
RUN chmod 0755 /usr/local/sbin/sn-entrypoint /usr/local/sbin/sn-init-firewall \
      /usr/local/sbin/sn-preflight /usr/local/sbin/sn-clean-home

ENV SN_AGENT_UID=${AGENT_UID} \
    SN_AGENT_GID=${AGENT_GID} \
    CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION} \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    UV_OFFLINE=1 \
    UV_NO_SYNC=1 \
    UV_FROZEN=1 \
    UV_PROJECT_ENVIRONMENT=/opt/visuals/.venv \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /work
ENTRYPOINT ["/usr/local/sbin/sn-entrypoint"]
