#!/bin/bash
# Pre-start check (plan 7.7), run by the entrypoint before the harness on every start.
# Exit codes: 0 ok, 210 a security point failed, 211 the model API is unreachable.
set -u

fail() { echo "sn-preflight: $*" >&2; exit 210; }

# 1. Only the expected mounts (Podman's own /proc, /sys and /dev mounts are allowed;
#    /run/podman-init is the read-only catatonit binary that `--init` binds in).
allowed_mounts=" / /work /home/agent /run/sn /in /out /tmp /etc/hosts /etc/hostname /etc/resolv.conf /run/.containerenv /run/podman-init "
while read -r target; do
    case "$target" in
        /proc|/proc/*|/sys|/sys/*|/dev|/dev/*) continue ;;
    esac
    case "$allowed_mounts" in
        *" $target "*) ;;
        *) fail "unexpected mount: $target" ;;
    esac
done < <(findmnt -rn -o TARGET)

# 2. Only the allowed environment keys; never an SSH agent socket.
allowed_env=" PATH HOME HOSTNAME TERM container SN_RUN_ID SN_ALLOWED_DOMAINS SN_MODEL_PROBE SN_NO_NETWORK SN_AGENT_UID SN_AGENT_GID CLAUDE_CODE_VERSION DISABLE_AUTOUPDATER DISABLE_TELEMETRY DISABLE_ERROR_REPORTING CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC UV_OFFLINE UV_NO_SYNC UV_FROZEN UV_PROJECT_ENVIRONMENT UV_PYTHON_DOWNLOADS NODE_VERSION YARN_VERSION PWD SHLVL _ "
while IFS='=' read -r key _; do
    [ -n "$key" ] || continue
    case "$allowed_env" in
        *" $key "*) ;;
        *) fail "unexpected environment variable: $key" ;;
    esac
done < <(env)
[ -z "${SSH_AUTH_SOCK:-}" ] || fail "SSH_AUTH_SOCK is set"

# 3. No owner home, no tool configuration, no Git metadata or keys behind /work.
for entry in /home/*; do
    [ "$entry" = /home/agent ] || [ "$entry" = '/home/*' ] || fail "unexpected home: $entry"
done
found=$(find / -xdev -maxdepth 5 -path '*/.config/school-notes' -print -quit 2>/dev/null)
[ -z "$found" ] || fail "tool configuration visible: $found"
if [ -d /work ]; then
    if [ -e /work/.git ] || [ -L /work/.git ]; then
        [ -f /work/.git ] && [ ! -L /work/.git ] || fail "/work/.git is not a plain file"
        gitdir=$(sed -n 's/^gitdir: //p' /work/.git | head -n 1)
        [ -z "$gitdir" ] || [ ! -e "$gitdir" ] || fail "the worktree's Git directory is visible"
    fi
    for bad in /work/.ssh /work/.config/school-notes /work/.gnupg; do
        [ ! -e "$bad" ] || fail "unexpected path in /work: $bad"
    done
fi
# The clean-up ran before us; a planted harness configuration means it did not work.
for planted in /home/agent/.claude/settings.json /home/agent/.claude/hooks \
               /home/agent/.claude/CLAUDE.md /home/agent/.codex/AGENTS.md \
               /home/agent/.codex/config.toml; do
    [ ! -e "$planted" ] || fail "harness configuration survived the clean-up: $planted"
done
if [ -d /home/agent/.claude/projects ] && [ -n "$(find -P /home/agent/.claude/projects -mindepth 1 \
        \( -name memory -o -name 'settings*.json' -o -name 'CLAUDE*.md' \
        -o -name 'AGENTS*.md' \) -print -quit)" ]; then
    fail "harness project memory or settings survived the clean-up"
fi

# 4. /run/sn holds only the MCP socket.
if [ -d /run/sn ]; then
    for entry in /run/sn/* /run/sn/.[!.]*; do
        [ -e "$entry" ] || continue
        [ "$entry" = /run/sn/mcp.sock ] || fail "unexpected entry in /run/sn: $entry"
        [ -S "$entry" ] || fail "/run/sn/mcp.sock is not a socket"
    done
fi

# 5. The firewall is alive: an unlisted address is unreachable (HTTPS and DNS over TCP to a
# non-resolver), the model API is reachable.
if [ "${SN_NO_NETWORK:-0}" != 1 ]; then
    if curl -sS -m 5 -o /dev/null https://example.com/ 2>/dev/null; then
        fail "firewall is not blocking https://example.com"
    fi
    resolvers=" $(awk '$1 == "nameserver" {print $2}' /etc/resolv.conf | tr '\n' ' ') "
    for candidate in 1.1.1.1 8.8.8.8 9.9.9.9; do
        case "$resolvers" in *" $candidate "*) continue ;; esac
        if timeout 5 bash -c "exec 3<>/dev/tcp/$candidate/53" 2>/dev/null; then
            fail "firewall lets port 53/TCP reach $candidate"
        fi
        break
    done
    probe=${SN_MODEL_PROBE:-}
    if [ -n "$probe" ] && ! curl -sS -m 5 -o /dev/null "$probe" 2>/dev/null; then
        echo "sn-preflight: model API unreachable: $probe" >&2
        exit 211
    fi
fi
exit 0
