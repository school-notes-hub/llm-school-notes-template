# Agent and vault workspaces
.claude/
.obsidian/

# OS junk
.DS_Store
._*
Thumbs.db
desktop.ini

# Editor workspaces
.vscode/
.idea/
*~

# Office lock and temp files
~$*
.~lock.*#
*.tmp

# Tool caches
__pycache__/
node_modules/
package-lock.json

# Python environment (uv)
.venv/

# Local credentials and environment overrides
.env
.env.*
!.env.example

# Private generated request state and optional Drive credentials
.learning-images-state/
.drive-state/

# Machine-local renderer paths and disposable execution records
visual-tools.local.json
.visual-runs/

# Reproducible page-check dependency lock (other ad-hoc npm locks stay ignored).
!tools/page-check/package-lock.json

# School Notes v2: the run's working files and renderer logs are never committed.
.school-notes/
wiki/assets/**/stdout.log
wiki/assets/**/stderr.log
wiki/assets/**/freecad-user.cfg

# Disposable test files when sandboxed runs cannot use system temp.
.test-tmp/
